# l-torrents — configuración. Se carga desde el EnvironmentFile de la unit.
# Copia esto a /var/www/l-torrents/.env y rellena el indexador.

PORT=3011

# ── El indexador ──────────────────────────────────────────────────────────
# Pon UNA de las dos. Si es un paquete de npm que exporta getMovies(),
# getSeries(), search()... usa INDEXADOR_MODULO (hay que instalarlo antes con
# npm install --prefix /var/www/l-torrents <paquete>). Si es un servicio HTTP,
# usa INDEXADOR_BASE; las rutas concretas se ajustan en lib/indexador.js, en la
# constante RUTAS de arriba del todo.
#INDEXADOR_MODULO=
# Ejemplo real con la fuente incluida (elitetorrent, ver README):
#INDEXADOR_MODULO=/ruta/al/proyecto/lib/fuente-elitetorrent.js
#INDEXADOR_BASE=https://ejemplo.tld/api
INDEXADOR_ESPERA_MS=15000

# ── transmission ──────────────────────────────────────────────────────────
# Los mismos valores que /etc/transmission-daemon/settings.json
TRANSMISION_URL=http://127.0.0.1:9091/transmission/rpc
TRANSMISION_USUARIO=lepayimio
TRANSMISION_CLAVE=CAMBIAME

# ── El buzón ──────────────────────────────────────────────────────────────
# De aquí lo recoge /usr/local/sbin/procesar-entrada.js cada 5 minutos.
BUZON=/var/media/entrada

# Cada cuánto se mira cómo van las descargas.
VIGILANCIA_MS=15000

# Espacio que hay que dejar SIEMPRE libre: es el que exige procesar-entrada.js
# para ponerse a trabajar. Por debajo de esto, el buzón se planta.
MARGEN_GB=8

# Días compartiendo antes de liberar el disco local de lo que ya está colocado
# en Jellyfin. El fichero de la biblioteca no se toca. 0 = no borrar nunca.
DIAS_SEMBRANDO=14

# Horas sin una sola semilla ni avance antes de dar una descarga por muerta.
HORAS_SIN_AVANCE=12
